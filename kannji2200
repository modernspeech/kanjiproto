# Normalize the Excel JSON into a compact app-friendly JSON (one object per kanji)
import pandas as pd, json, re, pathlib

src = "/mnt/data/Sheet1.json"
df = pd.read_json(src)

def pick(row, *names):
    out=[]
    for n in names:
        if n in row and pd.notna(row[n]) and str(row[n]).strip():
            out.append(str(row[n]).strip())
    return out

records=[]
for _, r in df.iterrows():
    obj = {
        "id": int(r["漢字番号"]) if pd.notna(r["漢字番号"]) else None,
        "char": r["漢字"],
        "radical": r.get("部首"),
        "strokes": int(r["総画数"]) if pd.notna(r["総画数"]) else None,
        "joyo": bool(r["常用漢字か否か"]) if "常用漢字か否か" in r and pd.notna(r["常用漢字か否か"]) else None,
        "grade": r.get("学年配当"),
        "jlpt": r.get("能力試験"),
        "kanken": r.get("漢検級数"),
        "jinmei": bool(r["人名用漢字か否か"]) if "人名用漢字か否か" in r and pd.notna(r["人名用漢字か否か"]) else None,
        "on": pick(r, "音読み1","音読み2","音読み3"),
        "kun": pick(r, "訓読み1","訓読み2","訓読み3"),
        "meanings_ja": pick(r, "日本語の意味1","日本語の意味2","日本語の意味3"),
        "meanings_en": pick(r, "英語の意味1","英語の意味2","英語の意味3"),
        "image_stroke": r.get("漢字と筆順の画像"),
        "image_font": r.get("明朝体とゴシックの画像"),
        "compounds": []
    }
    # up to 4 compounds with reading/english if present
    for i in range(1,5):
        w = r.get(f"熟語{i}")
        y = r.get(f"熟語{i}読み")
        e = r.get(f"熟語{i}英語") if f"熟語{i}英語" in r else None
        if pd.notna(w) and str(w).strip():
            citem={"word":str(w).strip()}
            if pd.notna(y) and str(y).strip(): citem["reading"]=str(y).strip()
            if e is not None and pd.notna(e) and str(e).strip(): citem["en"]=str(e).strip()
            obj["compounds"].append(citem)
    records.append(obj)

out_path="/mnt/data/kanji2200.min.json"
with open(out_path,"w",encoding="utf-8") as f:
    json.dump(records,f,ensure_ascii=False,indent=2)

len(records), out_path
